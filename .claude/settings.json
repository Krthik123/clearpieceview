{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.harness/harness.py\" hook post"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 120,
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.harness/harness.py\" hook stop"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.envrc)",
      "Edit(./.env)",
      "Edit(./.envrc)"
    ]
  }
}
